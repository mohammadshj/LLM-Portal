# Copy to .env; replace both values with independently generated secrets.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://portal.example.com
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=
# Legacy default connection (used by migration 0003).
# After migration edit endpoint/credential variable name in Django Admin.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Optional independent connections: enter only the VARIABLE NAME in Admin.
# Add more LLM_<SERVICE>_API_KEY variables as needed.
LLM_OPENAI_API_KEY=
LLM_OPENROUTER_API_KEY=
PORTAL_HTTP_PORT=8080
# Upstream deadlines in seconds: connect, inactivity between reads, total stream.
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=90
LLM_TOTAL_TIMEOUT=300
# Exact origins authorized for local provider discovery, e.g. http://127.0.0.1:11434
LLM_DISCOVERY_LOCAL_ORIGINS=
# Use only the local Models.dev snapshot during Sync.
LLM_DISCOVERY_REGISTRY_OFFLINE=false
